# Supabase URL (required)

SUPABASE_URL=https://your-project.supabase.co

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key



# Direct Postgres connection for automated migrations (required for db:migrate)

# Supabase → Project Settings → Database → Connection string (URI)

DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres



# Apply pending migrations on backend startup (default: true)

# AUTO_DB_MIGRATE=true



# Multi-tenant routing

DEFAULT_TENANT_SLUG=default

# Optional: paid custom domain with wildcard subdomains (https://{slug}.yourdomain.com)
# PLATFORM_DOMAIN=careersites.yourcompany.com

# Free tier: Vercel frontend URL — enables ?tenant= share links (no paid domain required)
APP_PUBLIC_URL=https://frontend-five-chi-66.vercel.app

# Outreach production sync (auto after create-prospect-from-url; see npm run ensure-outreach-production)
RENDER_API_URL=https://careers-api.onrender.com
# RENDER_API_KEY=                  # Render → Account Settings → API Keys (resume suspended services)
# VERCEL_TOKEN=                    # https://vercel.com/account/settings/tokens
# RENDER_DEPLOY_HOOK_URL=          # Render → careers-api → Deploy Hook
# VERCEL_DEPLOY_HOOK_URL=          # Vercel → frontend → Deploy Hooks (production)



# Auth

JWT_SECRET=change-me-to-a-long-random-string

# ADMIN_JWT_SECRET=optional-separate-admin-secret



# Internal provisioning API + demo builder (required for sales workflow)

PROVISION_API_KEY=change-me-provision-key



# Server

PORT=3000



# Public URLs (used in emails, prospect demo links, and CLI output)

# Free tier (default): your Vercel .vercel.app URL — share links use ?tenant=slug
APP_PUBLIC_URL=https://your-project.vercel.app

# Paid upgrade: same as apex when using PLATFORM_DOMAIN subdomains
# APP_PUBLIC_URL=https://careersites.yourcompany.com



# Mail

MAIL_PROVIDER=console

MAIL_FROM=careers@yourcompany.com

# RESEND_API_KEY=re_xxxxxxxx



# AI resume parsing (optional)
# Models fall back in order: gemini-3.1-flash → gemini-2.5-flash → gemini-2.5-flash-lite → gemini-2.5-flash-tts

# GEMINI_API_KEY=

