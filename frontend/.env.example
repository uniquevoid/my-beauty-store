# Public API (NestJS backend URL)
VITE_API_URL=https://api.yourplatform.com

# Optional: force a tenant in local dev (use ?tenant=slug in production instead)
# VITE_TENANT_SLUG=acme
# VITE_TENANT_HOST=acme.localhost

# Internal sales tool at /demo-builder (set true only on your platform deploy)
VITE_ENABLE_DEMO_BUILDER=true
